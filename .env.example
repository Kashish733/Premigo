# Copy this file to .env.local and fill it in privately. Never commit .env.local.

# All three LiveKit values must belong to one LiveKit Cloud project (Settings > API keys).
# On a Shared Chert plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Notice runs on Gemini: the voice (Gemini Live) and, unless ANTHROPIC_API_KEY is set, reading the documents.
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Optional. If set, Claude reads the documents instead of Gemini.
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=notice

# Optional tuning (all have sensible defaults):
# MOUTH_DELAY_MS=1400        # lip sync: raise it if the mouth moves before the voice, lower it if it lags (or say "the mouth is early/late" during a call)
# OUT_W=1280                 # video we send back (default 1280x720, 16:9)
# OUT_H=720
# VISION_MODEL=gemini-3.1-flash-lite   # model that reads the page
# VOICE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# NOTICE_MOCK=1              # pretend to read forms/permiso.json instead of calling a vision model
# NOTICE_CALIBRATE=1         # send a test pattern instead of the camera (to see how the phone fits our video)
